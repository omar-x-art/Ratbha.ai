# Public site URL (used for OAuth redirect URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie encryption (random 32+ bytes, base64 ok)
SESSION_SECRET=

# Supabase (used in Phase 5+ for plan persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth + Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Gemini API (defaults to gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Firebase Cloud Messaging (Phase 5+)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
